<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

  <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="Bot Token" android:endIconMode="dropdown_menu">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/inputToken"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="text"/>
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="Chat ID" android:endIconMode="dropdown_menu">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/inputChatId"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="text"/>
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="Chat IDs (comma-separated)" android:endIconMode="dropdown_menu">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/inputChatIds"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="text"/>
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="Parse Mode" android:endIconMode="dropdown_menu">
    <AutoCompleteTextView
        android:id="@+id/parseModeDropdown"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnSendTestTelegram"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Send Test Telegram"/>
</LinearLayout>
