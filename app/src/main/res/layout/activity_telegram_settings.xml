<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:clipToPadding="false" android:fillViewport="true">
  <LinearLayout android:id="@+id/rootTelegram" android:orientation="vertical"
      android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">

    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="12dp">
      <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/telegram_title" android:textStyle="bold" android:textSize="20sp"/>
      <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
      <Switch android:id="@+id/switchEnabled" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <EditText android:id="@+id/inputToken" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="@string/telegram_token" android:layout_marginTop="8dp" android:inputType="textPassword"/>

    <EditText android:id="@+id/inputChatIds" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="@string/telegram_chat_ids_hint" android:layout_marginTop="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/telegram_parse_mode"/>
    <Spinner android:id="@+id/spinnerParse" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/telegram_message_template"/>
    <EditText android:id="@+id/inputTemplate" android:layout_width="match_parent" android:layout_height="160dp"
      android:gravity="top|start" android:inputType="textMultiLine"
      android:text="[{{app}}] {{title}}&#10;{{text}}&#10;#{{channel}} ({{package}})&#10;{{timestamp}}"/>

    
    <CheckBox
      android:id="@+id/checkDisablePreview"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/telegram_disable_preview"
      android:checked="true"
      android:buttonTint="@color/white" android:button="@drawable/checkbox_selector"/>

    <CheckBox
      android:id="@+id/checkSilent"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/telegram_silent"
      android:buttonTint="@color/white" android:button="@drawable/checkbox_selector"/>

    <CheckBox
      android:id="@+id/checkProtect"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/telegram_protect"
      android:buttonTint="@color/white" android:button="@drawable/checkbox_selector"/>
<EditText android:id="@+id/inputThreadId" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="@string/telegram_thread_id_hint" android:layout_marginTop="8dp" android:inputType="number"/>

    <EditText android:id="@+id/inputWhitelist" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="@string/channel_whitelist_hint" android:layout_marginTop="12dp"/>

    <EditText android:id="@+id/inputContains" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="@string/contains_filter" android:layout_marginTop="8dp"/>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/save" android:textColor="@color/white"
       android:layout_marginTop="16dp" android:background="@drawable/btn_black_solid"/>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnSendTestTelegram" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="@string/send_test" android:textColor="@color/white"
       android:layout_marginTop="8dp" android:background="@drawable/btn_black_solid"/>

  </LinearLayout>
</ScrollView>