<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <Button android:id="@+id/btnOpenAccess" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Access"/>
    <Button android:id="@+id/btnWebhook" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Webhook" android:layout_marginTop="8dp"/>
    <Button android:id="@+id/btnEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email" android:layout_marginTop="8dp"/>
    <Button android:id="@+id/btnTelegram" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Telegram" android:layout_marginTop="8dp"/>
    <Button android:id="@+id/btnLogViewer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Log Viewer" android:layout_marginTop="8dp"/>
    <Button android:id="@+id/btnOfflineQueue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Offline Queue" android:layout_marginTop="8dp"/>
  </LinearLayout>
</ScrollView>
