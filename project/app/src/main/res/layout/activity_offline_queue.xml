<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootOfflineQueue"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:paddingTop="24dp"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/titleOfflineQueue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Offline Queue"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingBottom="8dp" />

    <Switch
        android:id="@+id/switchQueueEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enable queue" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnResendAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Resend (All)" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnClearQueue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear" />
    </LinearLayout>

</LinearLayout>
